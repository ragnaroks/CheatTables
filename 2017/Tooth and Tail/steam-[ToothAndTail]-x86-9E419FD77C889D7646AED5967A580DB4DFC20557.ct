          <Address>cheat2_store2</Address>
          <Offsets>
            <Offset>0</Offset>
          </Offsets>
          <CheatEntries>
            <CheatEntry>
              <ID>97</ID>
              <Description>"生命值"</Description>
              <ShowAsSigned>0</ShowAsSigned>
              <VariableType>4 Bytes</VariableType>
              <Address>+12C</Address>
            </CheatEntry>
          </CheatEntries>
        </CheatEntry>
        <CheatEntry>
          <ID>98</ID>
          <Description>"己方单位生命值处理方式"</Description>
          <DropDownList ReadOnly="1" DescriptionOnly="1" DisplayValueAsItem="1">0:默认
1:隐身
2:无敌
3:最大生命值 (推荐)
</DropDownList>
          <ShowAsSigned>0</ShowAsSigned>
          <VariableType>Byte</VariableType>
          <Address>cheat2_setting1</Address>
        </CheatEntry>
        <CheatEntry>
          <ID>99</ID>
          <Description>"敌方单位生命值处理方式"</Description>
          <DropDownList ReadOnly="1" DescriptionOnly="1" DisplayValueAsItem="1">0:默认
1:秒杀
</DropDownList>
          <ShowAsSigned>0</ShowAsSigned>
          <VariableType>Byte</VariableType>
          <Address>cheat2_setting2</Address>
        </CheatEntry>
      </CheatEntries>
    </CheatEntry>
    <CheatEntry>
      <ID>57</ID>
      <Description>"#3 阵营指针"</Description>
      <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
      <LastState/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript Async="1">// eax 是阵营指针

[ENABLE]
assert(Armada.GameplayEntity::get_Faction,8B 81 B8 00 00 00 C3 00)
alloc(cheat3_code,64,Armada.GameplayEntity::get_Faction)
registersymbol(cheat3_code)
label(return)
label(default)
label(player)
label(cheat3_store1)
label(cheat3_store2)
registersymbol(cheat3_store1)
registersymbol(cheat3_store2)

Armada.GameplayEntity::get_Faction:
  jmp cheat3_code
  nop
return:

cheat3_code:
  mov eax,[ecx+000000B8]
  pushfd
  cmp byte ptr [eax+80],01
  je player
default:
  mov [cheat3_store2],eax
  popfd
  jmp return
player:
  mov [cheat3_store1],eax
  popfd
  jmp return
cheat3_store1:
  DB 00 00 00 00
cheat3_store2:
  DB 00 00 00 00

[DISABLE]
Armada.GameplayEntity::get_Faction:
  DB 8B 81 B8 00 00 00 C3 00

unregistersymbol(*)
dealloc(*)
</AssemblerScript>

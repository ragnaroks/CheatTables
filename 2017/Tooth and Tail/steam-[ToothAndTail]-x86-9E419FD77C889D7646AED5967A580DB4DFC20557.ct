          <ShowAsSigned>0</ShowAsSigned>
          <VariableType>4 Bytes</VariableType>
          <Address>cheat1_store2</Address>
        </CheatEntry>
        <CheatEntry>
          <ID>16</ID>
          <Description>"己方食物处理方式"</Description>
          <DropDownList ReadOnly="1" DescriptionOnly="1" DisplayValueAsItem="1">00:默认
01:无限
02:锁 8192
</DropDownList>
          <ShowAsHex>1</ShowAsHex>
          <ShowAsSigned>0</ShowAsSigned>
          <VariableType>Byte</VariableType>
          <Address>cheat1_setting1</Address>
        </CheatEntry>
        <CheatEntry>
          <ID>17</ID>
          <Description>"敌方食物处理方式"</Description>
          <DropDownList ReadOnly="1" DescriptionOnly="1" DisplayValueAsItem="1">00:默认
01:默认
02:锁 1
</DropDownList>
          <ShowAsHex>1</ShowAsHex>
          <ShowAsSigned>0</ShowAsSigned>
          <VariableType>Byte</VariableType>
          <Address>cheat1_setting2</Address>
        </CheatEntry>
      </CheatEntries>
    </CheatEntry>
    <CheatEntry>
      <ID>91</ID>
      <Description>"#2 单位"</Description>
      <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
      <LastState/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript Async="1">// eax 单位指针
{$STRICT}
[ENABLE]
aobscan(cheat2_entry,BC ? ? ? ? 8B EC 56 83 EC 20 8B F1 8B CE E8 ? ? ? ? 3A 80 2C 01 00 00 8D 88 2C 01 00 00 8B 01 8B 51 04 89 45 DC 89 55 E0 DF 6D DC DD 5D DC DD 45 DC D8 35 ? ? ? ? D9 5D F8 8B CE,"+X+W")
assert(cheat2_entry+14,3A 80 2C 01 00 00)
registersymbol(cheat2_entry)
alloc(cheat2_code,64,cheat2_entry)
registersymbol(cheat2_code)
label(return)

{$C}
// 己方单位地址（最后一次）
unsigned int cheat2_store1=0x00;
// 其它单位地址（最后一次）
unsigned int cheat2_store2=0x00;
// 己方单位生命值处理方式，0:默认，1:不可选择，2:无敌，3:锁最大生命值
unsigned char cheat2_setting1=0x00;
// 敌方单位生命值处理方式，0:默认，1:秒杀
unsigned char cheat2_setting2=0x00;
{$ASM}

cheat2_entry+14:
  jmp cheat2_code
  nop
return:

cheat2_code:
{$CCODE refEAX=eax}
  unsigned int *ptrFaction=(unsigned int *)(refEAX+0xB8);
  if(*(unsigned char *)(*ptrFaction+0x80)!=0x01){
    //敌方
    cheat2_store2=refEAX;
    if(cheat2_setting2==1){ *(unsigned int *)(refEAX+0x12C)=0; }
  }else{
    //己方
    cheat2_store1=refEAX;
    switch(cheat2_setting1){
      case 0x01:
        *(unsigned char *)(refEAX+0xC5)=0x00;
      break;
      case 0x02:
        *(unsigned char *)(refEAX+0xC6)=0x01;
      break;
      case 0x03:
        *(unsigned int *)(refEAX+0x12C)=*(unsigned int *)(refEAX+0x154);
      break;
      default:break;
    }
  }
{$ASM}
  cmp al,[eax+0000012C]
  jmp return

[DISABLE]
cheat2_entry+14:
  DB 3A 80 2C 01 00 00

unregistersymbol(*)
dealloc(*)
</AssemblerScript>

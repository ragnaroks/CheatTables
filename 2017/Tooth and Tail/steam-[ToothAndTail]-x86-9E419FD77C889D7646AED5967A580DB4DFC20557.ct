<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="39">
  <CheatEntries>
    <CheatEntry>
      <ID>7</ID>
      <Description>"#1 食物"</Description>
      <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
      <LastState/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript Async="1">// eax 是阵营指针
// edx 是食物数量的地址
{$STRICT}
[ENABLE]
//Armada.Behaviors.Refinery::Execute
aobscan(cheat1_entry,55 8B EC 57 56 81 EC 14 01 00 00 8B F1 8D BD E4 FE FF FF B9 45 00 00 00 33 C0 F3 AB 8B CE 89 8D 04 FF FF FF 8B 85 04 FF FF FF 8B 50 0C,"+X+W")
assert(cheat1_entry+5CB,F3 0F 7E 02 66 0F D6 04 24)
registersymbol(cheat1_entry)
alloc(cheat1_code,64,cheat1_entry)
registersymbol(cheat1_code)
label(return)

{$C}
// 己方阵营地址
unsigned int cheat1_store1=0x00;
// 其它阵营地址
unsigned int cheat1_store2=0x00;
// 己方食物处理方式，0:默认，1:无限，2:锁 8192
unsigned char cheat1_setting1=0x00;
// 敌方食物处理方式，0:默认，1:默认，2:锁 1
unsigned char cheat1_setting2=0x00;
{$ASM}

cheat1_entry+5CB:
  jmp cheat1_code
  nop 4
return:

cheat1_code:
{$CCODE refEAX=eax refEDX=edx}
  if(*(unsigned char *)(refEAX+0x80)!=0x01){
    //敌方
    cheat1_store2=refEAX;
    if(cheat1_setting2==2){ *(unsigned int *)refEDX=0x1000; }
  }else{
    //己方
    cheat1_store1=refEAX;
    if(cheat1_setting1==1){
      *(unsigned char *)(refEAX+0x82)=0x01;
    }
    if(cheat1_setting1==2){
      *(unsigned int *)refEDX=0x2000000;
    }
  }
{$ASM}
  movq xmm0,[edx]
  movq [esp],xmm0
  jmp return

[DISABLE]
cheat1_entry+5CB:
  DB F3 0F 7E 02 66 0F D6 04 24

unregistersymbol(*)
dealloc(*)
</AssemblerScript>
      <CheatEntries>
        <CheatEntry>
          <ID>9</ID>

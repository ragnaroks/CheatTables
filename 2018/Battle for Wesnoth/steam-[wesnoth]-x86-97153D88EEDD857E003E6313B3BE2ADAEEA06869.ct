  pushfd
  cmp [edx+9C],79616C70
  jne default
  cmp [edx+A0],00007265
  jne default
  cmp [edx+10],00
  je default
  jmp case1
default:
  popfd
  sub [edx+04],eax
  jmp return
case1:

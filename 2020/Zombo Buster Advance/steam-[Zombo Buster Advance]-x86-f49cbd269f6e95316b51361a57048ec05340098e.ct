    <CheatEntry>
      <ID>5</ID>
      <Description>"#3 命令无冷却"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{$STRICT}
[ENABLE]
usemono()
findmonomethod(cheat3_entry,Assembly-CSharp:Command:.ctor)
assert(cheat3_entry+14,D9 45 10 D9 EE)
registersymbol(cheat3_entry)
label(returnhere)
alloc(newmem,32,cheat3_entry)
label(cheat3_code)

newmem:
  nop 4
cheat3_code:
// 堆栈中的 cooldown 在后面有再用到，不能用两个 fldz 替代
// 直接 mov dword ptr [ebp+10],00 会导致图标显示异常
  mov dword ptr [ebp+10],3C000000
  DB D9 45 10
  DB D9 EE
  jmp returnhere

cheat3_entry+14:
  jmp cheat3_code
returnhere:


[DISABLE]
cheat3_entry+14:
  DB D9 45 10
  DB D9 EE

unregistersymbol(*)
dealloc(*)
</AssemblerScript>
    </CheatEntry>

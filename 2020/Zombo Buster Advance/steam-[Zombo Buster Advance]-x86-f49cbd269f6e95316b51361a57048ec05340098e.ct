// aobscan issue =&gt; https://github.com/cheat-engine/cheat-engine/issues/288
//registersymbol(cheat6_entry)
//aobscanregion(cheat6_target,cheat6_entry,cheat6_entry+320,83 EC 08 6A 05 6A 00 E8 ?? ?? ?? ?? 83 C4 10)
aobscanregion(cheat6_target,Assembly-CSharp:InGame:GenerateBadges,Assembly-CSharp:InGame:GenerateBadges+320,83 EC 08 6A 05 6A 00 E8 ?? ?? ?? ?? 83 C4 10)
registersymbol(cheat6_target)
label(returnhere)
alloc(newmem,32,cheat6_entry)
label(cheat6_data)
registersymbol(cheat6_data)
label(cheat6_backup)
registersymbol(cheat6_backup)
label(cheat6_code)

newmem:
  nop 4
cheat6_data:
  DB 00
cheat6_backup:
  readmem(cheat6_target,15)
cheat6_code:
  mov al,byte ptr [cheat6_data]
  jmp returnhere

cheat6_target:
  nop 3
  nop 2
  nop 2
  jmp cheat6_code
  nop 3
returnhere:


[DISABLE]

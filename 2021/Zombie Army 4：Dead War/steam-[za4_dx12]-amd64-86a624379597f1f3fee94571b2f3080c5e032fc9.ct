cheat3_code:
  pushfq
  cmp dword ptr [rbx+88],563CA41E
  jne case_default
  cmp byte ptr [rbx+98],01
  jne case_default
  cmp byte ptr [rbx+AC],00
  jne case_default
  popfq
  xorps xmm6,xmm6
  DB 0F 28 C8
  jmp returnhere

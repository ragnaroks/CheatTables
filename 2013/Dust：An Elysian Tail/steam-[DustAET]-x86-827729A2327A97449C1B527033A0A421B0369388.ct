          </Offsets>
          <Hotkeys>
            <Hotkey>
              <Action>Decrease Value</Action>
              <Keys>
                <Key>16</Key>
                <Key>37</Key>
              </Keys>
              <Value>50</Value>
              <Description>左移 50 单位</Description>

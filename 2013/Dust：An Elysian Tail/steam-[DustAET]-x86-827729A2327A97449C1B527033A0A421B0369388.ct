<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="41">
  <CheatEntries>
    <CheatEntry>
      <ID>3</ID>
      <Description>"#1 获取人物结构地址"</Description>
      <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript Async="1">{$STRICT}
[ENABLE]
aobscan(cheat1_address,8B 48 08 89 8D 1C FE FF FF FF 35 ? ? ? ? 6A 00 8B 15 ? ? ? ? 8B 01 8B 40 28 FF 50 10,"+W+X")
registersymbol(cheat1_address)
alloc(cheat1_code,32,cheat1_address)
registersymbol(cheat1_code)
label(returnhere)
label(cheat1_store1)
registersymbol(cheat1_store1)

cheat1_code:
  mov ecx,[eax+08]
  mov [ebp-000001E4],ecx
  mov [cheat1_store1],ecx
  jmp returnhere
cheat1_store1:
  DB 00 00 00 00

cheat1_address:
  jmp cheat1_code
  nop 4
returnhere:

[DISABLE]
cheat1_address:
  DB 8B 48 08 89 8D 1C FE FF FF

unregistersymbol(*)
dealloc(*)
</AssemblerScript>

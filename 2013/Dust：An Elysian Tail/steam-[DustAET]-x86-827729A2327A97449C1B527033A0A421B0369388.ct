    <CheatEntry>
      <ID>8</ID>
      <Description>"#2 一击必杀"</Description>
      <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript Async="1">{$STRICT}
[ENABLE]
aobscan(cheat2_entry,55 8B EC 57 56 53 83 EC 20 8B F1 83 7E 48 00 74 08,"+W+X")
assert(cheat2_entry+8F,89 86 F8 00 00 00)
registersymbol(cheat2_entry)
alloc(cheat2_code,32,cheat2_entry)
registersymbol(cheat2_code)
label(returnhere)
label(enemy)
label(player)

cheat2_code:
  pushfd
  cmp [esi+24],00
  je player
  cmp [esi+44],00
  je player
  cmp [esi+48],00
  je player
enemy:
  popfd
  mov [esi+000000F8],01
  jmp returnhere
player:
  popfd
  mov [esi+000000F8],eax
  jmp returnhere

cheat2_entry+8F:
  jmp cheat2_code
  nop
returnhere:

[DISABLE]
cheat2_entry+8F:
  DB 89 86 F8 00 00 00

unregistersymbol(*)
dealloc(*)
</AssemblerScript>

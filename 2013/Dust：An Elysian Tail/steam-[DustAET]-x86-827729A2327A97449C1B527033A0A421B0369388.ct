    <CheatEntry>
      <ID>20</ID>
      <Description>"#3 获取状态结构地址"</Description>
      <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript Async="1">{$STRICT}
[ENABLE]
aobscan(cheat3_entry,55 8B EC 57 56 53 83 EC 08 8B F1 8B FA 83 3D,"+W+X")
assert(cheat3_entry+399,8B 0D)
assert(cheat3_entry+39F,8B D7 39 09)
alloc(cheat3_code,32,cheat3_entry)
registersymbol(cheat3_code)
label(cheat3_store1)
registersymbol(cheat3_store1)

cheat3_code:
  DB 00 00 00 00
cheat3_store1:
  readmem(cheat3_entry+39B,4)

[DISABLE]
unregistersymbol(*)
dealloc(*)
</AssemblerScript>

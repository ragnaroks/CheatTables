      <Description>"#1 获取坐标"</Description>
      <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>//AOB：48 8B 01 48 8D 54 24 30 41 B8 07 00 00 00 FF 90 00 03 00 00 44 0F 10 50 20 66 41 0F 73 DA 04 44
{$STRICT}
[ENABLE]
assert(hitman3.exe+2BB1F1,48 8B 01 48 8D 54 24 30)
alloc(newmem,64,hitman3.exe)
label(returnhere)
label(cheat1_code)
label(cheat1_data)
registersymbol(cheat1_data)

newmem:
  nop 4
cheat1_data:
  DB 00 00 00 00 00 00 00 00
cheat1_code:
  mov [cheat1_data],rcx
  DB 48 8B 01
  DB 48 8D 54 24 30
  jmp returnhere

hitman3.exe+2BB1F1:
  jmp cheat1_code
  nop 3
returnhere:


[DISABLE]
hitman3.exe+2BB1F1:
  DB 48 8B 01
  DB 48 8D 54 24 30

unregistersymbol(*)
dealloc(*)
</AssemblerScript>

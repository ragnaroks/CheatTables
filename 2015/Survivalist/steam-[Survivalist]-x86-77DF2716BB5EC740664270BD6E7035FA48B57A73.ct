    <CheatEntry>
      <ID>3</ID>
      <Description>"精力值固定"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
assert(ZombieApocalypse.Character::ApplyFatiguePenalty+64,D9 9E B4 01 00 00)


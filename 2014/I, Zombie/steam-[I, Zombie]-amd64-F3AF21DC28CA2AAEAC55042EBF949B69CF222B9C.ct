    <CheatEntry>
      <ID>8</ID>
      <Description>"#2 设置玩家角色移动速度"</Description>
      <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{$STRICT}
[ENABLE]
usemono()
findmonomethod(cheat2_entry,:PlayerController:movement)
assert(cheat2_entry+2B,D9 05)
registersymbol(cheat2_entry)
label(returnhere)
alloc(newmem,32,cheat2_entry)
label(cheat2_code)
label(cheat2_data1)
registersymbol(cheat2_data1)
label(cheat2_data2)
registersymbol(cheat2_data2)

newmem:
  nop 4
cheat2_code:
  fld dword ptr [cheat2_data1]
  jmp returnhere
align 4 90
cheat2_data1:
  DB 00 00 FA 43
cheat2_data2:
  readmem(cheat2_entry+2D,4)

cheat2_entry+2B:
  jmp cheat2_code
  nop
returnhere:


[DISABLE]
cheat2_entry+2B:
  DB D9 05
  readmem(cheat2_data2,4)

unregistersymbol(*)
dealloc(*)
</AssemblerScript>
      <CheatEntries>
        <CheatEntry>
          <ID>9</ID>
          <Description>"设置值为"</Description>
          <ShowAsSigned>0</ShowAsSigned>
          <VariableType>Float</VariableType>
          <Address>cheat2_data1</Address>
        </CheatEntry>
      </CheatEntries>
    </CheatEntry>
  </CheatEntries>

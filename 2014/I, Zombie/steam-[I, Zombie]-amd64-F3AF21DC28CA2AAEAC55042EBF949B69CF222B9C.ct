<CheatTable UsesMono="1" CheatEngineTableVersion="52">
  <CheatEntries>
    <CheatEntry>
      <ID>4</ID>
      <Description>"#1 玩家角色无敌"</Description>
      <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{$STRICT}
[ENABLE]
usemono()
findmonomethod(cheat1_entry,:PlayerController:OnDamage)
assert(cheat1_entry,55)
registersymbol(cheat1_entry)

cheat1_entry:
  DB C3


[DISABLE]
cheat1_entry:
  DB 55

unregistersymbol(*)
</AssemblerScript>

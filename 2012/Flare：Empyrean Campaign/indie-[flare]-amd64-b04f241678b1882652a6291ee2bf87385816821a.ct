    <CheatEntry>
      <ID>9</ID>
      <Description>"#2 攻击力 10 倍"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{$STRICT}
[ENABLE]
assert("flare.exe"+D6C96,F3 0F 10 44 C2 04 F3 0F 5F 04 C2)
assert("flare.exe"+D6CA1,F3 0F 11 43 0C)
alloc(cheat2_newmem,128,"flare.exe")
label(returnhere)
label(cheat2_data1)
label(cheat2_code)
label(case_default)

cheat2_newmem:
  nop 4
cheat2_data1:
  DB 00 00 20 41
cheat2_code:
  pushfq
  push rax
  mov rax,[flare.exe+189750]
  mov rax,[rax+1D8]
  cmp rdx,rax
  pop rax
  jne case_default
  mulss xmm0,[cheat2_data1]
  cmp [rdx],00
case_default:
  popfq
  movss [rbx+0C],xmm0
  jmp returnhere

"flare.exe"+D6CA1:
  jmp cheat2_code
returnhere:


[DISABLE]
"flare.exe"+D6CA1:
  DB F3 0F 11 43 0C

dealloc(*)
</AssemblerScript>

          <ID>5</ID>
          <Description>"生命值"</Description>
          <ShowAsSigned>0</ShowAsSigned>
          <VariableType>Float</VariableType>
          <Address>cheat1_newmem+04</Address>
        </CheatEntry>
        <CheatEntry>

  <CheatEntries>
    <CheatEntry>
      <ID>4</ID>
      <Description>"#1 设定生命值和魔法值"</Description>
      <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{$STRICT}
[ENABLE]
assert("flare.exe"+225DC,F3 0F 10 8B 78 02 00 00)
alloc(cheat1_newmem,128,"flare.exe")
registersymbol(cheat1_newmem)
label(returnhere)
label(cheat1_code)
label(cheat1_data1)
label(cheat1_data2)

cheat1_newmem:
  nop 4
cheat1_data1:
  DB 00 00 80 45
cheat1_data2:
  DB 00 00 80 44
cheat1_code:
  movss xmm1,[cheat1_data2]
  movss [rbx+27C],xmm1
  movss xmm1,[cheat1_data1]
  movss [rbx+278],xmm1
  jmp returnhere

"flare.exe"+225DC:
  jmp cheat1_code
  nop 3
returnhere:

[DISABLE]
"flare.exe"+225DC:
  DB F3 0F 10 8B 78 02 00 00

dealloc(*)
unregistersymbol(*)
</AssemblerScript>
      <CheatEntries>

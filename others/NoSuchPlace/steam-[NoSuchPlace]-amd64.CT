        <CheatEntry>
          <ID>29</ID>
          <Description>"触发传送"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{$STRICT}
[ENABLE]
alloc(newmem,128)
label(exit)

// r10 =&gt; cheat1_data1
// r11 =&gt; cheat4_data1
// r12 =&gt; cheat4_data2

newmem:
  pushfq
  sub rsp,28
// check actor pointers
  mov r10,cheat1_data1
  mov r10,[r10]
  test r10,r10
  je exit
  mov r10,[r10+10]
  test r10,r10
  je exit
  mov r10,[r10+28]
  test r10,r10
  je exit
  mov r10,[r10+38]
  test r10,r10
  je exit
// check cords
  mov r11,cheat4_data1
  test r11,r11
  je exit
  mov r12,cheat4_data2
  test r12,r12
  je exit
// teleport
  mov eax,[r11]
  mov [r10+74],eax
  mov eax,[r12]
  mov [r10+7C],eax
exit:
  add rsp,28
  popfq
  xor rax,rax
  ret

createthread(newmem)
[DISABLE]
dealloc(*)
</AssemblerScript>

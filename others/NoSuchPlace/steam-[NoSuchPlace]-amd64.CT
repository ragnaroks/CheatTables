assert(cheat4_entry+F2,48 03 C1 48 83 C0 20)
registersymbol(cheat4_entry)
alloc(newmem,128,cheat4_entry)
label(returnhere)
label(cheat4_code)
label(cheat4_data1)
registersymbol(cheat4_data1)
label(cheat4_data2)
registersymbol(cheat4_data2)

newmem:
  nop 4
cheat4_data1:
  DB 00 00 00 00
cheat4_data2:
  DB 00 00 00 00
cheat4_code:
  DB 48 03 C1
  DB 48 83 C0 20
  push rax
  mov eax,[rbp-44]
  mov [cheat4_data1],eax
  mov eax,[rbp-3C]
  mov [cheat4_data2],eax
  pop rax
  jmp returnhere

cheat4_entry+F2:
  jmp cheat4_code
  nop 2
returnhere:


